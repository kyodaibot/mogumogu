# Copy to .env and adjust: cp .env.example .env
# This file is read by both `docker compose` and the shell (`source .env`).
# Keep values simple: no spaces, quotes, $ or # in any value.

# --- Backend ---
# Port the Go backend listens on. Optional, defaults to 8080.
APP_PORT=8080

# --- Auth ---
# HMAC key for session JWTs, at least 32 bytes. This placeholder is too short on
# purpose, so the backend refuses to start until you set a real value.
# `make setup` generates one; by hand: openssl rand -base64 48
JWT_SECRET=change-me
# HMAC key for CSRF tokens, at least 32 bytes, different from JWT_SECRET.
# Generate it separately: openssl rand -base64 48
CSRF_SECRET=change-me-too
# Session lifetime as a Go duration. Optional, defaults to 168h (7 days).
JWT_TTL=168h
# JWT iss and aud claims. Optional, default to mogumogu and mogumogu-web.
JWT_ISSUER=mogumogu
JWT_AUDIENCE=mogumogu-web
# Origins allowed to send write requests, comma-separated without spaces.
# For local development this is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173
# Mark cookies Secure. Keep false for local http; set true when served over HTTPS.
COOKIE_SECURE=false

# --- Meal assistant ---
# Port of the internal API the AI service's query tools call. Optional,
# defaults to 8081. Never published or forwarded by Nginx.
INTERNAL_PORT=8081
# Base URL of the AI service (ai/). Optional, defaults to http://127.0.0.1:8090,
# the port `make dev` and `make ai` run it on.
AI_SERVICE_URL=http://127.0.0.1:8090
# Daily message quota per user and for the whole site. Optional, default 30 and 300.
ASSISTANT_USER_DAILY_LIMIT=30
ASSISTANT_SITE_DAILY_LIMIT=300

# --- AI service (ai/) ---
# bedrock calls the real model; fake answers with fixed text (tests, CI, E2E).
MODEL_PROVIDER=bedrock
# Bedrock inference profile (Japan cross-region). Optional; this is the default.
BEDROCK_MODEL_ID=jp.anthropic.claude-haiku-4-5-20251001-v1:0
# AWS CLI profile whose temporary credentials the AI service uses, after
# `aws login --profile <name>`. Never put access keys in this file.
# Uncomment and set it, or leave it out to use the default profile.
# AWS_PROFILE=dev

# --- Frontend dev server ---
# Where the Vite dev server proxies /api requests. Optional, defaults to http://localhost:8080.
API_PROXY_TARGET=http://localhost:8080

# --- Container setup (make app-up) ---
# Host port Nginx is published on (bound to 127.0.0.1 only). Optional, defaults
# to 8000. The containerized backend allows http://localhost:<this port> as origin.
WEB_PORT=8000

# --- Database (shared by compose and the backend) ---
# Host the backend connects to. The compose port is published on localhost.
DB_HOST=localhost
# Database name created in the postgres container.
DB_NAME=mogumogu
# Database user created in the postgres container.
DB_USER=mogumogu
# Database password. Placeholder only; use your own local value.
DB_PASSWORD=change-me-local-only
# Host port PostgreSQL is published on (bound to 127.0.0.1 only); the backend
# connects to the same port. Change it if another PostgreSQL already uses 5432.
DB_PORT=5432
# PostgreSQL sslmode used by the backend. Optional, defaults to disable.
# Local compose has no TLS; use require or verify-full for a remote database.
DB_SSLMODE=disable

# --- Local test accounts (make seed-local) ---
# Password of the local test accounts busy, normal and light, at least 8
# characters. Placeholder only; use your own local value.
SEED_PASSWORD=change-me-local-only
