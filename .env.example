# Copy to .env and adjust: cp .env.example .env
# This file is read by both `docker compose` and the shell (`source .env`).
# Keep values simple: no spaces, quotes, $ or # in any value.

# --- Backend ---
# Port the Go backend listens on. Optional, defaults to 8080.
APP_PORT=8080

# --- Auth ---
# HMAC key for session JWTs, at least 32 bytes. This placeholder is too short on
# purpose, so the backend refuses to start until you set a real value.
# `make setup` generates one; by hand: openssl rand -base64 48
JWT_SECRET=change-me
# HMAC key for CSRF tokens, at least 32 bytes, different from JWT_SECRET.
# Generate it separately: openssl rand -base64 48
CSRF_SECRET=change-me-too
# Session lifetime as a Go duration. Optional, defaults to 168h (7 days).
JWT_TTL=168h
# JWT iss and aud claims. Optional, default to mogumogu and mogumogu-web.
JWT_ISSUER=mogumogu
JWT_AUDIENCE=mogumogu-web
# Origins allowed to send write requests, comma-separated without spaces.
# For local development this is the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173
# Mark cookies Secure. Keep false for local http; set true when served over HTTPS.
COOKIE_SECURE=false

# --- Frontend dev server ---
# Where the Vite dev server proxies /api requests. Optional, defaults to http://localhost:8080.
API_PROXY_TARGET=http://localhost:8080

# --- Database (shared by compose and the backend) ---
# Host the backend connects to. The compose port is published on localhost.
DB_HOST=localhost
# Database name created in the postgres container.
DB_NAME=mogumogu
# Database user created in the postgres container.
DB_USER=mogumogu
# Database password. Placeholder only; use your own local value.
DB_PASSWORD=change-me-local-only
# Host port PostgreSQL is published on (bound to 127.0.0.1 only); the backend
# connects to the same port. Change it if another PostgreSQL already uses 5432.
DB_PORT=5432
# PostgreSQL sslmode used by the backend. Optional, defaults to disable.
# Local compose has no TLS; use require or verify-full for a remote database.
DB_SSLMODE=disable
